# ---------------------------------------------------------------------------
# VoiceRiders local configuration
# Copy this file to `.env` and fill in your own values. `.env` is git-ignored.
# Expo inlines every EXPO_PUBLIC_* variable into the JS bundle at build time.
# ---------------------------------------------------------------------------

# Spotify application (public "Client ID" only -- NEVER the client secret).
# Create one at https://developer.spotify.com/dashboard
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# Spotify requires an HTTPS redirect URI and REJECTS custom app schemes, so this
# must be the URL of the small relay in `relay/` (deploy it, then register this
# exact address in the Spotify dashboard).
#   Example: https://voiceriders.vercel.app/api/spotify-callback
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=

# Optional: override where the relay hands control back to the app.
# Default (development build / production): voiceriders://spotify-callback
# In Expo Go this is exp://<your-host>:8081/--/spotify-callback and changes per
# machine, so set it explicitly if you develop the OAuth flow in Expo Go.
EXPO_PUBLIC_SPOTIFY_APP_RETURN_URI=

# Optional: Spotify market/country code used for some playback calls (ISO 3166-1 alpha-2).
EXPO_PUBLIC_SPOTIFY_MARKET=IN

# ---------------------------------------------------------------------------
# Speech recognition
#
# Provider choice:
#   auto      (default) on-device when the model is installed, else cloud, else none
#   on-device whisper.cpp on the phone (offline, private, no API key) -- dev build
#   cloud     POST each utterance to EXPO_PUBLIC_ASR_ENDPOINT
#   off       disable recognition
# ---------------------------------------------------------------------------
EXPO_PUBLIC_ASR_PROVIDER=auto

# --- On-device Whisper (recommended) ---------------------------------------
# The model is downloaded at runtime from Settings; it is never bundled or
# committed. Swap the URL to trade speed for accuracy:
#   ggml-tiny.en.bin    ~75 MB   fastest
#   ggml-base.en.bin   ~142 MB   better in noise
#   ggml-small.en.bin  ~466 MB   best, slowest
EXPO_PUBLIC_WHISPER_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-tiny.en.bin
EXPO_PUBLIC_WHISPER_MODEL_FILENAME=ggml-tiny.en.bin
EXPO_PUBLIC_WHISPER_USE_GPU=true
EXPO_PUBLIC_WHISPER_MAX_THREADS=4

# --- Cloud ASR (optional, development only) --------------------------------
# Leave blank to disable. WARNING: anything in EXPO_PUBLIC_* ends up inside the
# shipped bundle, so a key placed here is NOT a secret. For production, point
# this at your own backend proxy and keep the provider key on the server.
EXPO_PUBLIC_ASR_ENDPOINT=
EXPO_PUBLIC_ASR_API_KEY=
EXPO_PUBLIC_ASR_MODEL=whisper-1

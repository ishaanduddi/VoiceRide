# ---------------------------------------------------------------------------
# VoiceRiders local configuration
# Copy this file to `.env` and fill in your own values. `.env` is git-ignored.
# Expo inlines every EXPO_PUBLIC_* variable into the JS bundle at build time.
# ---------------------------------------------------------------------------

# Spotify application (public "Client ID" only -- NEVER the client secret).
# Create one at https://developer.spotify.com/dashboard
# Redirect URI to register there (exactly):
#   voiceriders://spotify-callback
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# Optional: Spotify Market/country code used for some playback calls (ISO 3166-1 alpha-2).
EXPO_PUBLIC_SPOTIFY_MARKET=IN

# ---------------------------------------------------------------------------
# Optional cloud Speech-to-Text used for development in Expo Go.
# Leave blank to disable cloud ASR (the app then offers the on-screen
# manual command box so you can still exercise the NLP pipeline).
#
# WARNING: anything in EXPO_PUBLIC_* ends up inside the shipped bundle.
# A key placed here is NOT a secret. For production, point ASR_ENDPOINT at your
# own backend proxy and keep the real provider key on the server.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_ASR_ENDPOINT=
EXPO_PUBLIC_ASR_API_KEY=
EXPO_PUBLIC_ASR_MODEL=whisper-1

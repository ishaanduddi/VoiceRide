# VoiceRiders npm configuration.
#
# Why this file exists:
#   Expo SDK 57 pins react@19.2.3 (required by react-native 0.86.x), but the
#   newest react-dom (19.3.x) declares `peer react@^19.3.0`. npm 11 treats that
#   peer mismatch as FATAL (ERESOLVE), which breaks plain `npm install` and
#   `npx expo lint` for everyone on the team.
#
#   This project does not use react-dom (there is no web target), so resolving
#   peers the same way Expo's own tooling does is safe and keeps installs
#   reproducible for all contributors.
legacy-peer-deps=true
